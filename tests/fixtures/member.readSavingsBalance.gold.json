{
  "schemaVersion": "1",
  "capability": {
    "id": "member.readSavingsBalance",
    "version": "1.0.0",
    "title": "Read a member's regular savings balance",
    "description": "Looks up a member by member number in MockCore Teller and returns the current balance of their S00 regular savings share. Read-only. Returns the MEMBER_NOT_FOUND outcome when the member number does not exist on the system.",
    "app": {
      "appId": "mockcore-teller",
      "vendor": "MockCore",
      "uiVersionObserved": "v7.2.14"
    },
    "surface": "web",
    "entrypoint": {
      "kind": "url",
      "value": "{baseUrl}/login"
    }
  },
  "provenance": {
    "recordedAt": "2026-08-15T00:00:00Z",
    "recordedBy": {
      "kind": "hand-authored"
    },
    "approval": {
      "state": "approved",
      "by": "engineering review",
      "at": "2026-08-15T00:00:00Z"
    }
  },
  "params": {
    "memberId": {
      "type": "string",
      "description": "The member number to look up.",
      "required": true,
      "pattern": "^[0-9]{3,10}$",
      "example": "12345",
      "sensitivity": "internal",
      "source": "caller"
    },
    "operatorId": {
      "type": "string",
      "description": "Teller operator ID used to sign in. Resolved from the environment, never stored.",
      "required": true,
      "sensitivity": "internal",
      "source": "env",
      "env": "MOCK_CU_USER"
    },
    "operatorPassword": {
      "type": "string",
      "description": "Teller password. Resolved from the environment at invocation time; secret values are never serialized into artifacts, logs, or evidence.",
      "required": true,
      "sensitivity": "secret",
      "source": "env",
      "env": "MOCK_CU_PASS"
    }
  },
  "outputs": {
    "savingsBalance": {
      "type": "money",
      "description": "Current balance of the member's S00 REGULAR SAVINGS share, as displayed (e.g. \"$4,821.97\").",
      "sensitivity": "pii",
      "source": {
        "stepId": "s8",
        "transform": "trim"
      }
    }
  },
  "outcomes": [
    {
      "code": "MEMBER_NOT_FOUND",
      "description": "No member matched the given member number. A legitimate business result the caller must handle — not a failure.",
      "when": {
        "c": "textPresent",
        "pattern": "No members matched your search."
      },
      "terminal": true,
      "outputs": {}
    }
  ],
  "recoveries": [
