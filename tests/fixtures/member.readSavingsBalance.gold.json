        "c": "textPresent",
        "pattern": "Your session has expired"
      },
      "handler": {
        "kind": "restartRun"
      },
      "maxAttempts": 2
    },
    {
      "code": "KNOWN_INTERSTITIAL",
      "description": "The system-notice interstitial appeared instead of the requested screen. Dismiss it via its Continue control.",
      "when": {
        "c": "textPresent",
        "pattern": "System Notice"
