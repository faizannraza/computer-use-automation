<%- include('partials/top', { heading: 'Confirmation' }) %>
<table class="frm ok" cellspacing="0" cellpadding="4" align="center">
<tr><td class="th ok" colspan="2">Sub-Account Opened Successfully</td></tr>
<tr><td class="lbl">Confirmation No.</td><td><%= confirmationNo %></td></tr>
<tr><td class="lbl">Member</td><td><%= member.id %> &mdash; <%= member.name %></td></tr>
<tr><td class="lbl">New Suffix</td><td><%= account.suffix %></td></tr>
<tr><td class="lbl">Account Type</td><td><%= account.type %></td></tr>
<tr><td class="lbl">Nickname</td><td><%= account.nickname %></td></tr>
<tr><td class="lbl">Opening Balance</td><td><%= formatMoney(account.balanceCents) %></td></tr>
<tr><td colspan="2"><a class="btn" href="/members/<%= member.id %>">Return to Member</a></td></tr>
</table>
<%- include('partials/bottom') %>
