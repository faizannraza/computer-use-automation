<!DOCTYPE html>
<html>
<head>
<title><%= title %></title>
<link rel="stylesheet" href="/static/legacy.css">
</head>
<body class="scr login">
<table class="loginbox" cellspacing="0" cellpadding="6" align="center">
<tr><td class="c1" colspan="2">MockCore&trade; Teller &mdash; Operator Sign In</td></tr>
<% if (expired) { %>
<tr><td colspan="2"><span class="err">Your session has expired. Please sign in again.</span></td></tr>
<% } %>
<% if (error) { %>
<tr><td colspan="2"><span class="err"><%= error %></span></td></tr>
<% } %>
<form method="post" action="/login">
<tr><td class="lbl"><label for="u">Operator ID</label></td><td><input type="text" name="txtUser" id="u" size="18"></td></tr>
<tr><td class="lbl"><label for="p">Password</label></td><td><input type="password" name="txtPass" id="p" size="18"></td></tr>
<tr><td></td><td><input type="submit" class="btn" value="Sign In"></td></tr>
</form>
<tr><td colspan="2" class="fine">Unauthorized access is prohibited. Activity is monitored.</td></tr>
</table>
</body>
</html>
