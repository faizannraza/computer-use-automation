  "capability": {
    "id": "member.readBalances",
    "version": "1.0.0",
    "title": "Read Member Shares/Balances",
    "description": "Signs on to MERIDIAN CORE as the operator, opens Member Inquiry, searches by member number for the supplied memberId, and opens the member record. Captures the full SHARES / BALANCES table into output 'shares' (columns: Share ID, Type, Balance, Status). Inputs: memberId, operatorId, operatorPassword (secret). Handles the MEMBER_NOT_FOUND outcome when a member number does not exist (marker: \"No member records matched your search.\").",
    "app": {
      "appId": "meridian-core",
      "vendor": "Cornerstone Financial Systems"
    },
    "surface": "web",
    "entrypoint": {
      "kind": "url",
      "value": "{baseUrl}/"
    }
  },
  "provenance": {
    "recordedAt": "2026-08-20T19:48:53.287Z",
    "recordedBy": {
      "kind": "llm-discovery",
      "model": "claude-opus-4-8",
      "discoveryRunId": "20260820-124803-gz6r"
    },
    "evidenceRef": "evidence/meridian/discovery/20260820-124803-gz6r",
    "approval": {
      "state": "approved",
      "by": "Muhammad Faizan Raza",
      "at": "2026-08-20T21:44:20.634Z"
    }
  },
  "params": {
    "memberId": {
      "type": "integer",
      "description": "Typed into the \"Value\" field on screen.",
      "required": true,
      "pattern": "^[0-9]+$",
      "example": "100234",
      "sensitivity": "internal",
      "source": "caller"
    },
    "operatorId": {
      "type": "string",
      "description": "Resolved from the environment (MERIDIAN_OPERATOR_ID) at invocation time; never stored in the artifact.",
      "required": true,
      "sensitivity": "internal",
      "source": "env",
      "env": "MERIDIAN_OPERATOR_ID"
    },
    "operatorPassword": {
      "type": "string",
      "description": "Resolved from the environment (MERIDIAN_OPERATOR_PASSWORD) at invocation time; never stored in the artifact.",
      "required": true,
      "sensitivity": "secret",
      "source": "env",
      "env": "MERIDIAN_OPERATOR_PASSWORD"
    }
  },
  "outputs": {
    "shares": {
      "type": "table",
      "description": "Capture the whole SHARES / BALANCES table for the member.",
      "sensitivity": "none",
      "source": {
        "stepId": "s8",
        "transform": "trim"
      }
    }
  },
  "outcomes": [
    {
      "code": "MEMBER_NOT_FOUND",
