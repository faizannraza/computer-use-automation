{
  "schemaVersion": "1",
  "capability": {
    "id": "session.signOn",
    "version": "1.0.0",
    "title": "Operator Sign On to Meridian Core",
    "description": "Signs an operator on to MERIDIAN CORE from the OPERATOR SIGN ON screen using operatorId, operatorPassword (secret), and branch parameters, then lands on the MAIN MENU and returns the signed-on operator identity from the status bar as output 'sessionBanner'. Exceptional outcome BAD_CREDENTIALS occurs when an invalid «secret:operatorPassword» is supplied (marker: \"Invalid operator ID or «secret:operatorPassword».\").",
    "app": {
      "appId": "meridian-core",
      "vendor": "Cornerstone Financial Systems"
    },
    "surface": "web",
    "entrypoint": {
      "kind": "url",
      "value": "{baseUrl}/"
    }
  },
  "provenance": {
    "recordedAt": "2026-08-20T19:48:59.860Z",
    "recordedBy": {
      "kind": "llm-discovery",
      "model": "claude-opus-4-8",
      "discoveryRunId": "20260820-124803-nqfc"
    },
    "evidenceRef": "evidence/meridian/discovery/20260820-124803-nqfc",
    "approval": {
      "state": "approved",
      "by": "Muhammad Faizan Raza",
      "at": "2026-08-20T19:53:14.550Z"
    }
  },
  "params": {
    "branch": {
      "type": "string",
      "description": "Caller-supplied parameter 'branch'.",
      "required": true,
      "example": "MAIN-001",
      "sensitivity": "none",
      "source": "caller"
    },
    "operatorId": {
      "type": "string",
      "description": "Resolved from the environment (MERIDIAN_OPERATOR_ID) at invocation time; never stored in the artifact.",
      "required": true,
      "sensitivity": "internal",
      "source": "env",
      "env": "MERIDIAN_OPERATOR_ID"
    },
    "operatorPassword": {
      "type": "string",
      "description": "Resolved from the environment (MERIDIAN_OPERATOR_PASSWORD) at invocation time; never stored in the artifact.",
      "required": true,
      "sensitivity": "secret",
      "source": "env",
      "env": "MERIDIAN_OPERATOR_PASSWORD"
    }
  },
  "outputs": {
    "sessionBanner": {
      "type": "string",
      "description": "Capture the signed-on operator identity shown in the status bar.",
      "sensitivity": "none",
      "source": {
        "stepId": "s5",
        "transform": "trim"
      }
    }
  },
  "outcomes": [
    {
      "code": "BAD_CREDENTIALS",
      "description": "Signing on with an incorrect «secret:operatorPassword» is rejected: the OPERATOR SIGN ON screen redisplays with an error and no session is established.",
