  "schemaVersion": "1",
  "capability": {
    "id": "member.openShare",
    "version": "1.0.0",
    "title": "Open New Share for Member",
    "description": "Signs on to MERIDIAN CORE, looks up a member by Member Number (memberId), opens a new share of the given shareType with the given initialDeposit, and commits the opening after the review screen. Inputs: memberId, shareType (underlying value e.g. MMKT), initialDeposit, plus operator credentials. Returns the confirmation number (output 'confirmationNumber') from the Share Opened screen. The commit step is irreversible.",
    "app": {
      "appId": "meridian-core",
      "vendor": "Cornerstone Financial Systems"
    },
    "surface": "web",
    "entrypoint": {
      "kind": "url",
      "value": "{baseUrl}/"
    }
  },
  "provenance": {
    "recordedAt": "2026-08-20T19:49:07.952Z",
