# Copy to .env and fill in. The .env file is git-ignored — never commit secrets.

# Needed by the two places a model is in the loop: `discover`, and the
# chatbot's LLM planner. `replay`, `catalog`, the capability API, the
# dashboard, the mock app and the chatbot's `scripted` planner all run
# without it.
ANTHROPIC_API_KEY=

# Optional overrides
CU_MODEL=claude-opus-4-8
MOCK_CU_PORT=4173

# The API server (npm run api) — all optional, defaults shown.
#
# CU_APP_PROFILE and CU_CAPABILITIES_DIR are a PAIR and only make sense
# together: the profile decides which application is being driven (its base
# URL, credentials, recoveries and the policy's origin allowlist), and the
# capabilities directory holds flows recorded against THAT application. Point
# them at different apps and the server serves artifacts whose origins its own
# policy denies. These are the server's built-in defaults, spelled out:
#   MERIDIAN CORE   → profiles/meridian-core.profile.json + capabilities-meridian/
#   MockCore (demo) → profiles/mockcore-teller.profile.json + capabilities/
CU_API_PORT=4180
CU_APP_PROFILE=profiles/meridian-core.profile.json
CU_CAPABILITIES_DIR=capabilities-meridian
CU_POLICY=
CU_EVIDENCE_DIR=evidence
# Fault injection is a HARNESS affordance. The CLI's --inject always works;
# set this to expose it as an API request option too (off by default, because
# it rewrites requests to the live target beneath the ActionGate).
CU_ALLOW_INJECT=

# Demo operator credentials for the mock app. Capabilities resolve these at
# invocation time (params with source: "env") — credentials are never stored
# in artifacts, logs, or evidence. These are fake demo values.
MOCK_CU_USER=teller1
MOCK_CU_PASS=Passw0rd!

# MERIDIAN CORE (the adaptation target) — the brief's public demo operators.
# No real credentials or PII; the app is a hosted sample.
#
# Capabilities declare their operator params against the STABLE names
# MERIDIAN_OPERATOR_ID / MERIDIAN_OPERATOR_PASSWORD. You do not set those:
# `--app profiles/meridian-core.profile.json` maps them onto the per-role
# variables below, per invocation, so `--role supervisor` never edits an
# artifact and never mutates the process environment.
MERIDIAN_TELLER_ID=teller1
MERIDIAN_TELLER_PASSWORD=password
MERIDIAN_SUPERVISOR_ID=super1
MERIDIAN_SUPERVISOR_PASSWORD=password

# Optional: model used by the chatbot's LLM planner (it also has a
# deterministic 'scripted' planner that needs no key).
CU_CHAT_MODEL=claude-sonnet-4-5
