# Copy to .env and fill in. The .env file is git-ignored — never commit secrets.

# Required only for `discover` (the LLM-driven discovery run).
# `replay`, `catalog`, and the mock app run without it.
ANTHROPIC_API_KEY=

# Optional overrides
CU_MODEL=claude-opus-4-8
MOCK_CU_PORT=4173

# Demo operator credentials for the mock app. Capabilities resolve these at
# invocation time (params with source: "env") — credentials are never stored
# in artifacts, logs, or evidence. These are fake demo values.
MOCK_CU_USER=teller1
MOCK_CU_PASS=Passw0rd!
