  "done": {
    "capabilityId": "member.readSavingsBalance",
    "title": "Read Member REGULAR SAVINGS Balance",
    "description": "Signs into MockCore Teller with operator credentials, searches for a member by member number (parameter memberId), opens the member's details, and reads the balance of their REGULAR SAVINGS (suffix S00) account into output 'savingsBalance'. Requires operatorId/operatorPassword and memberId. Returns savingsBalance (PII). Exceptional outcome MEMBER_NOT_FOUND is declared when the searched member number does not exist (message: \"No members matched your search.\")."
  }
