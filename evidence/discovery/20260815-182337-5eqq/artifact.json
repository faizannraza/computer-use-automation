      "kind": "llm-discovery",
      "model": "claude-opus-4-8",
      "discoveryRunId": "20260815-182337-5eqq"
    },
    "evidenceRef": "evidence/discovery/20260815-182337-5eqq",
    "approval": {
      "state": "draft"
    }
  },
  "params": {
    "memberId": {
      "type": "string",
      "description": "Caller-supplied parameter 'memberId'.",
      "required": true,
      "pattern": "^[0-9]+$",
      "example": "12345",
      "sensitivity": "internal",
      "source": "caller"
    },
    "operatorId": {
      "type": "string",
      "description": "Resolved from the environment (MOCK_CU_USER) at invocation time; never stored in the artifact.",
      "required": true,
      "sensitivity": "internal",
      "source": "env",
      "env": "MOCK_CU_USER"
    },
    "operatorPassword": {
      "type": "string",
