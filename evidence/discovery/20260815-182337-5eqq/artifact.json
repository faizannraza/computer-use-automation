      "sensitivity": "secret",
      "source": "env",
      "env": "MOCK_CU_PASS"
    }
  },
  "outputs": {
    "savingsBalance": {
      "type": "money",
      "description": "Read the REGULAR SAVINGS (S00) account balance.",
      "sensitivity": "pii",
      "source": {
        "stepId": "s8",
        "transform": "trim"
      }
    }
  },
  "outcomes": [
