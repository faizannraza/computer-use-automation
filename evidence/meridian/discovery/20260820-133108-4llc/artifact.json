    "version": "1.0.0",
    "title": "Operator Sign On to Meridian Core",
    "description": "Signs an operator on to MERIDIAN CORE from the OPERATOR SIGN ON screen using operatorId, operatorPassword, and branch parameters, landing on the MAIN MENU. Returns the signed-on operator identity from the status bar as 'sessionBanner'. Handles the BAD_CREDENTIALS outcome when an invalid credential is supplied (sign-on screen redisplays with an 'Invalid operator ID or ...' error and no session is created).",
    "app": {
      "appId": "meridian-core",
      "vendor": "Cornerstone Financial Systems"
    },
    "surface": "web",
    "entrypoint": {
      "kind": "url",
      "value": "{baseUrl}/"
    }
  },
