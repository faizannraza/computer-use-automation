      "model": "claude-opus-4-8",
      "discoveryRunId": "20260820-133108-4llc"
    },
    "evidenceRef": "evidence/meridian/discovery/20260820-133108-4llc",
    "approval": {
      "state": "draft"
    }
  },
  "params": {
