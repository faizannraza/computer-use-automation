  "schemaVersion": "1",
  "capability": {
    "id": "member.updateInfo",
    "version": "1.0.0",
    "title": "Update Member Information",
    "description": "Signs on to MERIDIAN CORE, searches Member Inquiry by Member Number for the given memberId, selects the record, and opens Update Member Information. Types the email, phone, and address parameters into the E-mail, Phone, and Mailing Address fields and clicks Save Changes (an irreversible record modification). Confirms success via the 'CHANGES SAVED' / 'MEMBER INFORMATION UPDATED' screen (outcome UPDATE_SAVED). Inputs: memberId, email, phone, address, plus operatorId/operatorPassword resolved from the environment.",
    "app": {
      "appId": "meridian-core",
      "vendor": "Cornerstone Financial Systems"
    },
    "surface": "web",
    "entrypoint": {
      "kind": "url",
      "value": "{baseUrl}/"
    }
  },
  "provenance": {
    "recordedAt": "2026-08-20T19:57:35.790Z",
    "recordedBy": {
      "kind": "llm-discovery",
      "model": "claude-opus-4-8",
      "discoveryRunId": "20260820-125646-4tb7"
    },
    "evidenceRef": "evidence/meridian/discovery/20260820-125646-4tb7",
    "approval": {
      "state": "draft"
    }
  },
