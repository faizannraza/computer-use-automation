{
  "schemaVersion": "1",
  "capability": {
    "id": "member.updateInfo",
    "version": "1.0.0",
    "title": "Update Member Information",
    "description": "Signs on to MERIDIAN CORE, opens Member Inquiry, searches by Member Number for the 'memberId' parameter and selects the member, then opens 'Update Member Information' and writes the 'email', 'phone', and 'address' parameters into the E-mail, Phone, and Mailing Address fields. Clicking 'Save Changes' commits the member-record change (irreversible). On the resulting confirmation screen it captures the success confirmation indicator into output 'confirmation' (value \"MEMBER INFORMATION UPDATED\"). Note: the detailed confirmation sentence renders as plain non-semantic text and is not exposed as an addressable element, so the addressable success heading is used as the confirmation value. Inputs: memberId, email, phone, address, operatorId, operatorPassword.",
    "app": {
      "appId": "meridian-core",
      "vendor": "Cornerstone Financial Systems"
    },
    "surface": "web",
    "entrypoint": {
      "kind": "url",
      "value": "{baseUrl}/"
    }
  },
