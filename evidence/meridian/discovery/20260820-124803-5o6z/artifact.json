  "capability": {
    "id": "member.transferFunds",
    "version": "1.0.0",
    "title": "Member Funds Transfer",
    "description": "Signs on to MERIDIAN CORE, opens Member Inquiry, searches by Member Number for memberId and selects the member, then posts a Funds Transfer. Inputs: memberId, fromShare and toShare (share value attributes), amount, memo, plus operator credentials from the environment. Executes the transfer (irreversible Post Transfer) and returns the receipt's confirmationNumber. Outcome: transfer posted successfully.",
    "app": {
      "appId": "meridian-core",
      "vendor": "Cornerstone Financial Systems"
    },
    "surface": "web",
    "entrypoint": {
      "kind": "url",
      "value": "{baseUrl}/"
    }
  },
