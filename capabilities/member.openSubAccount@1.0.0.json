{
  "schemaVersion": "1",
  "capability": {
    "id": "member.openSubAccount",
    "version": "1.0.0",
    "title": "Open a new sub-account for a member",
    "description": "Opens a new sub-account (share) for an existing member in MockCore Teller: search, open the member, fill the sub-account form, review, and confirm. The confirm step is IRREVERSIBLE (posts the opening deposit) and is policy-gated: under the default policy it requires human approval. If the teller lacks permission, the app demands supervisor authorization — a human-only action that escalates to an operator on the live session. Returns the confirmation number and the new account suffix.",
    "app": {
      "appId": "mockcore-teller",
      "vendor": "MockCore",
      "uiVersionObserved": "v7.2.14"
    },
    "surface": "web",
    "entrypoint": {
      "kind": "url",
      "value": "{baseUrl}/login"
    }
  },
  "provenance": {
    "recordedAt": "2026-08-15T00:00:00Z",
    "recordedBy": {
      "kind": "hand-authored"
    },
    "approval": {
      "state": "approved",
      "by": "engineering review",
      "at": "2026-08-15T00:00:00Z"
    }
  },
  "params": {
    "memberId": {
      "type": "string",
      "description": "The member number to open the sub-account for.",
      "required": true,
      "pattern": "^[0-9]{3,10}$",
      "example": "12345",
      "sensitivity": "internal",
      "source": "caller"
    },
    "acctType": {
      "type": "enum",
      "description": "The share type to open.",
      "required": true,
      "values": [
        "REGULAR SAVINGS",
        "CHECKING",
        "MONEY MARKET",
        "HOLIDAY CLUB"
      ],
      "example": "HOLIDAY CLUB",
      "sensitivity": "none",
      "source": "caller"
    },
    "nickname": {
      "type": "string",
      "description": "Display nickname for the new sub-account (1-20 characters).",
      "required": true,
      "example": "Vacation Fund",
      "sensitivity": "none",
      "source": "caller"
    },
    "initialDeposit": {
      "type": "money",
      "description": "Opening deposit in dollars (minimum $25.00), e.g. '50.00'.",
      "required": true,
      "pattern": "^[0-9][0-9,]*(\\.[0-9]{2})?$",
      "example": "50.00",
      "sensitivity": "none",
      "source": "caller"
    },
    "operatorId": {
      "type": "string",
      "description": "Teller operator ID used to sign in. Resolved from the environment, never stored.",
      "required": true,
      "sensitivity": "internal",
      "source": "env",
      "env": "MOCK_CU_USER"
    },
    "operatorPassword": {
      "type": "string",
      "description": "Teller password. Resolved from the environment at invocation time; never serialized.",
      "required": true,
      "sensitivity": "secret",
      "source": "env",
      "env": "MOCK_CU_PASS"
    }
  },
  "outputs": {
    "confirmationNo": {
      "type": "string",
      "description": "The confirmation number issued for the opened sub-account.",
      "sensitivity": "internal",
      "source": {
        "stepId": "s14",
        "transform": "trim"
      }
    },
    "newSuffix": {
      "type": "string",
      "description": "The share suffix assigned to the new sub-account (e.g. S02).",
      "sensitivity": "none",
      "source": {
        "stepId": "s15",
        "transform": "trim"
      }
    }
  },
  "outcomes": [
    {
      "code": "MEMBER_NOT_FOUND",
      "description": "No member matched the given member number. A legitimate business result the caller must handle — not a failure.",
      "when": {
        "c": "textPresent",
        "pattern": "No members matched your search."
      },
      "terminal": true,
      "outputs": {}
    },
    {
      "code": "VALIDATION_REJECTED",
      "description": "The application rejected the sub-account details (bad deposit, nickname, or type). The caller must correct the inputs; nothing was opened.",
      "when": {
        "c": "any",
        "of": [
          {
            "c": "textPresent",
            "pattern": "Initial deposit must be at least"
          },
          {
            "c": "textPresent",
            "pattern": "Nickname is required"
          },
          {
            "c": "textPresent",
            "pattern": "Select a valid account type"
          }
        ]
      },
      "terminal": true,
      "outputs": {}
    }
  ],
  "recoveries": [
    {
      "code": "SESSION_TIMEOUT",
      "description": "The operator session expired mid-flow. Restart from the entrypoint — the engine refuses this once an irreversible step has completed.",
      "when": {
        "c": "textPresent",
        "pattern": "Your session has expired"
      },
      "handler": {
        "kind": "restartRun"
      },
      "maxAttempts": 2
    },
    {
      "code": "KNOWN_INTERSTITIAL",
      "description": "The system-notice interstitial appeared instead of the requested screen. Dismiss it via its Continue control.",
      "when": {
        "c": "textPresent",
        "pattern": "System Notice"
      },
      "handler": {
        "kind": "dismiss",
        "target": {
          "framePath": [],
          "strategies": [
            {
              "s": "roleName",
              "role": "link",
              "name": "Continue",
              "nameMatch": "exact"
            }
          ],
          "disambiguation": {
            "requireUnique": true,
            "minScore": 0.6
          }
        }
      },
      "maxAttempts": 2
    },
    {
      "code": "SUPERVISOR_AUTH_REQUIRED",
      "description": "The app demands supervisor authorization (PRM-4031) before the sub-account can be opened. Only a person with the supervisor PIN can clear this on the live session.",
      "when": {
        "c": "textPresent",
        "pattern": "Supervisor Authorization Required"
      },
      "handler": {
        "kind": "escalate",
        "suggestion": "A supervisor must enter their PIN on the authorization screen in the live window and click Authorize. When the confirmation screen appears, resolve with 'resume'."
      },
      "maxAttempts": 1
    }
  ],
  "anomalies": [
    {
      "code": "APP_ERROR",
      "description": "MockCore rendered its application-error screen (ERR-5000).",
      "when": {
        "c": "textPresent",
        "pattern": "ERR-5000"
      }
    }
  ],
