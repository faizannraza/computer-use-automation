{
  "name": "computer-use-automation",
  "version": "0.1.0",
  "private": true,
  "description": "Computer-use automation system: LLM-driven discovery of UI flows in legacy back-office apps, compiled into typed capability artifacts and replayed deterministically with safety guardrails and human-in-the-loop escalation.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "mock": "tsx apps/mock-cu/server.ts",
    "cu": "tsx src/cli.ts",
    "discover": "tsx src/cli.ts discover",
    "replay": "tsx src/cli.ts replay",
    "catalog": "tsx src/cli.ts catalog",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.70.0",
    "dotenv": "^17.2.0",
    "ejs": "^3.1.10",
    "express": "^5.1.0",
    "playwright": "^1.56.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@types/ejs": "^3.1.5",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.30.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.40.0",
    "vitest": "^3.2.0"
  }
}
